<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Create Request - Resource Portal</title>
    <style>
        body { font-family: sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; }
        form { display: flex; flex-direction: column; gap: 15px; }
        textarea { padding: 10px; border: 1px solid #ccc; border-radius: 4px; min-height: 100px; }
        button { padding: 10px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; }
        .back-link { display: inline-block; margin-bottom: 20px; text-decoration: none; color: #555; }
    </style>
</head>
<body>
    <a href="/requests" class="back-link">&larr; Back to Requests</a>
    <h2>Create New Request</h2>
    <form action="/requests" method="POST">
        <label for="content">What resources do you need?</label>
        <textarea name="content" id="content" placeholder="Describe the resources you need..." required></textarea>
        <button type="submit">Submit Request</button>
    </form>
</body>
</html>
