<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Submit Report (Donos) - Resource Portal</title>
    <style>
      body {
        font-family: sans-serif;
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
      }
      .form-group {
        margin-bottom: 15px;
        border: 1px solid #ddd;
        padding: 10px;
        border-radius: 4px;
      }
      label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
      }
      input,
      textarea {
        width: 100%;
        padding: 8px;
        margin-bottom: 5px;
        box-sizing: border-box;
      }
      button {
        padding: 10px 15px;
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
      }
      .add-btn {
        background: #28a745;
        margin-bottom: 20px;
      }
      .back-link {
        display: inline-block;
        margin-bottom: 20px;
        text-decoration: none;
        color: #555;
      }
    </style>
    <script>
      let relativeCount = 0;

      function addRelative() {
        relativeCount++;
        const container = document.getElementById("relatives-container");
        const div = document.createElement("div");
        div.className = "form-group";
        div.innerHTML = `
                <h4>Relative #${relativeCount}</h4>
                <label>Name:</label>
                <input type="text" name="relatives[${relativeCount}][name]" required>
                <label>Case/File (Delo):</label>
                <textarea name="relatives[${relativeCount}][delo]" rows="2"></textarea>
            `;
        container.appendChild(div);
      }
    </script>
  </head>
  <body>
    <a href="/requests" class="back-link">&larr; Back to Requests</a>
    <h2>Submit Report on Relatives</h2>
    <p>Please list all relatives and their files.</p>

    <form action="/donos" method="POST">
      <div id="relatives-container"></div>

      <div class="form-group">
        <h4>Distinctive Features</h4>
        <p style="color: #666; font-size: 0.9em">
          Describe notable traits of the reported person using dot-notation for
          structured data.<br />
          Example:
          <code
            >Ivanov.height=tall&Ivanov.hair=dark&Ivanov.scar=left_cheek</code
          >
        </p>
        <label>Features (key=value pairs, use & to separate):</label>
        <textarea
          name="distinctive_features"
          rows="3"
          placeholder="e.g. Petrov.height=short&Petrov.beard=yes&Petrov.limp=right_leg"
        ></textarea>
      </div>

      <button type="button" class="add-btn" onclick="addRelative()">
        + Add Relative
      </button>
      <br />
      <button type="submit">Submit Report</button>
    </form>

    <script>
      addRelative();
    </script>
  </body>
</html>
